{
    // --- AI ---------------------------------------------------------
    "disable_ai": true,
    "show_edit_predictions": false,
    "edit_predictions": {
        "provider": "none"
    },

    // --- No autocomplete --------------------------------------------
    "show_completions_on_input": false,
    "show_completion_documentation": false,
    "completions": {
        "words": "disabled",
        "lsp": false
    },

    // --- No type hints, hovers, signatures, code actions -------------
    "inlay_hints": {
        "enabled": false
    },
    "hover_popover_enabled": false,
    "auto_signature_help": false,
    "show_signature_help_after_edits": false,
    "inline_code_actions": false,

    // --- No diagnostics ---------------------------------------------
    "diagnostics": {
        "inline": {
            "enabled": false
        }
    },
    "diagnostics_max_severity": "off",

    // --- No autoformatting ------------------------------------------
    "format_on_save": "off",

    // --- Panel layout -----------------------------------------------
    "project_panel": {
        "dock": "left"
    }
}
